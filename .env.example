# SmolOrchestrator environment configuration.
# `npm run setup` writes the real .env; this file documents every supported variable.
# Values without a comment are the built-in defaults.

# --- Server ---
HOST=127.0.0.1
PORT=8787
# Set true only when behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# --- Storage ---
STORAGE_PATH=storage
DB_PATH=storage/gateway.db
LOG_PATH=storage/logs

# --- Security ---
# Generated by setup.js (64 hex chars). Never set manually.
APP_SECRET=
# Set false only for local HTTP development.
COOKIE_SECURE=true
SESSION_TTL_MS=28800000
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MS=900000
IP_RATE_LIMIT=120
IP_RATE_WINDOW_MS=60000
MAX_BODY_BYTES=33554432

# --- Gateway ---
IDLE_TIMEOUT_MS=90000
MAX_ATTEMPTS=8
KEY_DISABLE_MS=3600000
BACKOFF_BASE_MS=60000
BACKOFF_CAP_MS=900000
PROBE_ENABLED=true
PROBE_BUDGET_PER_HOUR=12
PROBE_PROMPT=ping
PROBE_MAX_TOKENS=5

# --- Telemetry and logging ---
TELEMETRY_FLUSH_MS=500
TELEMETRY_BUFFER_MAX=10000
LOG_MAX_BYTES=10485760
LOG_KEEP=5
LOG_LEVEL=info
SHUTDOWN_DRAIN_MS=30000

# Maximum response bytes buffered to extract usage from non-streaming JSON.
USAGE_PARSE_MAX_BYTES=4194304

# Minimum admin password length enforced by setup.js.
MIN_PASSWORD_LENGTH=10

# --- Metrics and proactive health checks ---
# When set, GET /metrics requires `Authorization: Bearer <METRICS_TOKEN>`. Empty leaves it open.
METRICS_TOKEN=
# Proactively probe healthy routes on an interval; failures cool the route down before users see errors.
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_MS=900000

# --- Response cache and savings ---
# Exact-match cache for temperature=0 JSON requests, plus singleflight coalescing.
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_MS=300000
RESPONSE_CACHE_MAX_ENTRIES=500
RESPONSE_CACHE_MAX_BODY_BYTES=1048576
# Fraction of the input price assumed for provider-cached tokens (savings estimate).
CACHED_INPUT_DISCOUNT=0.1
# Soft budget warning threshold as a fraction of each limit.
BUDGET_WARN_RATIO=0.8

# --- Backups ---
BACKUP_ENABLED=true
BACKUP_INTERVAL_MS=86400000
BACKUP_KEEP=7
BACKUP_PATH=storage/backups

# --- Audit fixes: cache memory, proxy trust, retention ---
RESPONSE_CACHE_MAX_TOTAL_BYTES=67108864
KEY_RETRIES_PER_ROUTE=2
MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_MS=86400000
# 0 keeps rows forever. Audit rows are never pruned.
TELEMETRY_RETENTION_DAYS=30
USAGE_RETENTION_DAYS=90
